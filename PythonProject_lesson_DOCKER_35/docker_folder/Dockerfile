# базовий образ
# версія пайтона

FROM python:3.11-slim

# базова директорія(папка)
WORKDIR app

# скопіювати файли в образ
# скопіювати все - весь код що хочемо запускати
COPY ./ ./

# встановлення бібліотек - всіх, що є локально, зберігаються в файл, щоб було всередині докера
RUN pip install -r requirements.txt

# відкрити порт
EXPOSE 8080

# команда при запуску
CMD ["python3", "main.py"]
